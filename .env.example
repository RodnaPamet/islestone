# Copy to .env.local for local development. Never commit a real .env file.
# The values below are the docker-compose.yml development defaults and hold no
# secrets. Production values live in the deployment's secret store, never here.

# development | test | production. `next dev` and `next start` set it themselves.
# NODE_ENV=development

# Required. The runtime database URL: PgBouncer (transaction mode), not
# Postgres directly.
DATABASE_URL=postgresql://islestone:islestone_dev@127.0.0.1:6432/islestone

# Direct Postgres connection for the Prisma CLI (migrations need DDL and lock
# semantics PgBouncer does not provide). Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=postgresql://islestone:islestone_dev@127.0.0.1:5432/islestone

# Optional read replica (docs/database-routing.md). Unset = single database.
# DATABASE_READ_URL=

# Optional minimum log level: debug | info | warn | error | fatal.
# Defaults to debug in development and info otherwise.
# LOG_LEVEL=

# The job queue and the worker heartbeat (sub-phase 1.6). REQUIRED in
# production, with a password in the URL. Matches the dev password in
# docker-compose.yml.
REDIS_URL=redis://:islestone_dev@127.0.0.1:6379

# Required. Public origin of the app; inlined into the client bundle at build.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Authentication (sub-phase 1.4) ──────────────────────────────────────────

# Required. Signs the session JWT. At least 16 characters; generate one with
# `openssl rand -base64 32`. The value below is for local development only.
AUTH_SECRET=local-dev-auth-secret-change-me

# NextAuth's canonical URL, and the public origin used in emailed links.
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Optional OAuth sign-in. Each provider is offered only when both its values
# are set. MICROSOFT_TENANT_ID defaults to `common`.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Public self-sign-up at /api/auth/register (ADR 0006): 1 opens it, 0 closes
# it. Unset, it is closed in production and open otherwise.
# AUTH_PUBLIC_SIGNUP=

# Public intake forms (sub-phase 2.6b): 1 opens them, 0 closes them. Unset,
# they are closed in production and open otherwise.
# INTAKE_PUBLIC_FORMS=

# Inbound email intake (sub-phase 2.6c): 1 opens it, 0 closes it. Unset, it is
# closed in production and open otherwise. Opened in production it needs both
# Resend values (docs/deployment.md, "Email (Resend)").
# INTAKE_EMAIL=
# INTAKE_EMAIL_DOMAIN=in.islestone.cloud
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=whsec_...
# The receiving MTA's authserv-id in Authentication-Results; unset, no sender
# is treated as authenticated.
# INTAKE_EMAIL_AUTHSERV_ID=

# 1: a password sign-in needs a verified email address.
# AUTH_REQUIRE_EMAIL_VERIFICATION=
# 1: the sign-in page hides the email and password form.
# AUTH_CREDENTIALS_UI_HIDDEN=

# Test only. AUTH_TEST_MODE=1 turns off the credential throttle and the rate
# limits; production refuses it unless NEXT_TEST_MODE=1 (the E2E server only).
# AUTH_TEST_MODE=
# NEXT_TEST_MODE=

# Platform-operator key (at least 32 characters) and its predecessor during a
# rotation. No route uses it yet.
# PLATFORM_ADMIN_API_KEY=
# PLATFORM_ADMIN_API_KEY_PREVIOUS=

# Rate limits: `upstash` (the default, needs the two Upstash values) or
# `memory` (one process). RATE_LIMIT_ENABLED=0 turns every limit off.
# Production refuses to start with `upstash` and either Upstash value missing
# (issue #17): configure Upstash, or choose `memory` explicitly.
RATE_LIMIT_MODE=memory
# RATE_LIMIT_ENABLED=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Test only: 1 lets the edge logger write under NODE_ENV=test.
# EDGE_LOGGER_IN_TEST=

# ── Security perimeter (sub-phase 1.5, docs/encryption.md) ──────────────────

# The master key-encryption key for field encryption, at least 32 characters.
# REQUIRED in production (the documented dev fallback is refused there);
# development and test fall back to a well-known key when it is unset.
# Generate one with `openssl rand -base64 48`.
# DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-48-output-here # pragma: allowlist secret
# The outgoing key during a master-key rotation (a decrypt fallback only).
# DATA_ENCRYPTION_KEY_PREVIOUS=
# Set both at first deploy, to their own values or to DATA_ENCRYPTION_KEY's,
# so a later KEK rotation moves neither the email lookup hashes nor any
# derived subkey. See docs/encryption.md, "Rotating keys safely".
# LOOKUP_HASH_KEY=
# DERIVED_SUBKEY_KEY=
# Incident lever: 0 lets a read that fails to decrypt pass the ciphertext
# through instead of failing the request. Leave unset normally.
# ENCRYPTION_DECRYPT_FAIL_CLOSED=
# 0 sends each audit-stream batch once, without retries.
# AUDIT_STREAM_RETRY_ENABLED=
# Self-hosted only: private CIDRs safeFetch may reach, comma-separated.
# EGRESS_PRIVATE_CIDR_ALLOWLIST=10.0.0.0/8
# 1 sends the CSP as report-only (violations show, nothing is blocked).
# CSP_REPORT_ONLY=
# Origins allowed to call /api/** cross-origin, comma-separated. Unset in
# production means none; development and test also admit http://localhost.
# CORS_ALLOWED_ORIGINS=
# Billing (sub-phase 8.1). Set means a hosted deployment, unset self-hosted.
# STRIPE_SECRET_KEY=

# ── Jobs, notifications and observability (sub-phase 1.6) ───────────────────

# OpenTelemetry (docs/observability.md). Off unless OTEL_ENABLED=true.
# OTEL_ENABLED=
# OTEL_DEBUG=
# OTEL_SERVICE_NAME=islestone
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# The deployment's sender address for outbound email. Unset, mail is sent
# from a placeholder under the reserved .invalid domain, which no relay
# accepts (src/lib/email/sender-identity.ts owns it).
# SMTP_FROM=
# SMTP relay (src/lib/mailer.ts). Unset, mail goes to the console sink (logged
# by recipient hash, never delivered). Port 465 is implicit TLS; 587 the default.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Sentry error reporting (src/lib/observability/sentry.ts). Off unless the DSN
# is set. Server-side only: no browser SDK is initialised.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0
# Client: 1 in the Playwright build only.
# NEXT_PUBLIC_TEST_MODE=
# Client: 1 opts the notification bell into the live stream; unset, it polls.
# NEXT_PUBLIC_NOTIFICATIONS_SSE=

# ── Environments and delivery (sub-phase 1.8) ───────────────────────────────

# The commit the image was built from; the Dockerfile bakes it in from the
# BUILD_SHA build argument, and /api/readyz reports it. Unset reads as `dev`.
# BUILD_SHA=

# Set to 1 to skip env validation (CI builds, tests). Leave unset otherwise.
# SKIP_ENV_VALIDATION=1

# Work items (sub-phase 2.2). The zone the due-date reminder counts calendar
# days in, and the daily reminder job's cron zone (IANA name).
# NOTIFICATIONS_TZ=Europe/London
# Days a deleted work item or project stays restorable before the purge job
# removes it (ADR 0002: 30).
# WORK_ITEM_PURGE_DAYS=30
