// Tenancy: organizations, workspaces (the `Tenant` model), users and the two
// membership tables. Names follow ADR 0006: the workspace is `Tenant` in code
// and the database, "Workspace" in everything a customer reads.
//
// Row-level security (prisma/migrations/*_tenancy_core):
//   TenantMembership   tenant axis, Class A (app.tenant_id)
//   Organization       org axis (app.user_id)
//   OrgMembership      org axis (app.user_id)
//   Tenant, User       global, no RLS
// See docs/rls-tenant-isolation.md.

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants                      Tenant[]
  memberships                  OrgMembership[]
  provisionedTenantMemberships TenantMembership[] @relation("OrgProvisionedTenantMemberships")
  invites                      OrgInvite[]
  auditLogs                    OrgAuditLog[]
}

model OrgMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(ORG_READER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// A workspace: the unit of isolation, billing and membership. Every tenant
/// table carries its id as `tenantId`.
model Tenant {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  /// Hub-and-spoke parent. Nullable: a workspace need not belong to an
  /// organization. ON DELETE SET NULL, so removing an organization does not
  /// take its workspaces with it.
  organizationId       String?
  /// Soft delete. When set, the workspace is filtered out of tenant
  /// resolution (`resolveTenantContext` answers 404) while its data is
  /// retained. The last-owner trigger lets a soft-deleted workspace lose its
  /// last OWNER, so a purge can remove its memberships.
  deletedAt            DateTime?
  /// This workspace's data-encryption key (DEK), wrapped under the master
  /// KEK (sub-phase 1.5, src/lib/security/tenant-key-manager.ts). Nullable so
  /// `ensureTenantDek`'s lazy path stays reachable for a workspace created
  /// without one.
  encryptedDek         String?
  /// The outgoing DEK while a DEK rotation's re-encryption sweep runs; NULL
  /// otherwise. The CHECK `Tenant_previousEncryptedDek_differs` refuses it
  /// equal to `encryptedDek`, and the partial index
  /// `Tenant_rotation_in_flight_idx` finds rotations in flight (both in the
  /// 1.5 migration; Prisma's schema expresses neither).
  previousEncryptedDek String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships  TenantMembership[]

  securitySettings TenantSecuritySettings?
  invites          TenantInvite[]
  mfaEnrollments   UserMfaEnrollment[]
  customRoles      TenantCustomRole[]
  auditLogs        AuditLog[]
  auditOutbox      AuditOutbox[]

  notifications        Notification[]
  notificationOutbox   NotificationOutbox[]
  notificationSettings TenantNotificationSettings?
  notificationPrefs    NotificationPreference[]
  mentions             Mention[]

  teams                  Team[]
  workflowStates         WorkflowState[]
  projects               Project[]
  projectKeyPrefixes     ProjectKeyPrefix[]
  projectKeySeqs         ProjectKeySequence[]
  workItemTypes          WorkItemType[]
  workItems              WorkItem[]
  workItemKeyAliases     WorkItemKeyAlias[]
  workItemRelations      WorkItemRelation[]
  labels                 Label[]
  workItemLabels         WorkItemLabel[]
  comments               Comment[]
  workItemWatchers       WorkItemWatcher[]
  workItemLinks          WorkItemLink[]
  customFields           CustomField[]
  customFieldOptions     CustomFieldOption[]
  customFieldValues      CustomFieldValue[]
  savedViews             SavedView[]
  cycleSchedules         CycleSchedule[]
  cycles                 Cycle[]
  milestones             Milestone[]
  workItemTemplates      WorkItemTemplate[]
  workItemTemplateLabels WorkItemTemplateLabel[]
  projectTemplates       ProjectTemplate[]
  workItemRecurrences    WorkItemRecurrence[]
  workItemTransitions    WorkItemTransition[]
  workItemTypeFields     WorkItemTypeField[]
  projectIntakes         ProjectIntake[]
  intakeNotifyMembers    IntakeNotifyMember[]
  intakeForms            IntakeForm[]
  intakeRequests         IntakeRequest[]
  intakeFollowUps        IntakeFollowUp[]
  intakeBlockedSenders   IntakeBlockedSender[]
  intakeInboundEmails    IntakeInboundEmail[]

  @@index([organizationId])
}

/// A user's membership in one workspace, with one role ("Member" in the UI).
model TenantMembership {
  id                 String           @id @default(cuid())
  tenantId           String
  userId             String
  /// Least privilege by default: VIEWER is also the fallback role (ADR 0006).
  role               Role             @default(VIEWER)
  status             MembershipStatus @default(ACTIVE)
  invitedAt          DateTime?
  invitedByUserId    String?
  deactivatedAt      DateTime?
  /// When non-NULL, this membership was created by an organization's
  /// provisioning (sub-phase 1.4) for the named organization. NULL means
  /// it was created directly. ON DELETE SET NULL on the organization.
  provisionedByOrgId String?
  /// A custom role (sub-phase 1.4). Never on an OWNER membership: the CHECK
  /// `TenantMembership_built_in_scope_role_no_custom_role`.
  customRoleId       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  invitedBy        User?             @relation("MembershipInviter", fields: [invitedByUserId], references: [id])
  provisionedByOrg Organization?     @relation("OrgProvisionedTenantMemberships", fields: [provisionedByOrgId], references: [id], onDelete: SetNull)
  customRole       TenantCustomRole? @relation(fields: [customRoleId], references: [id])

  /// Work items this member is the assignee of (ADR 0003, RESTRICT).
  assignedWorkItems WorkItem[]               @relation("WorkItemAssignee")
  waitedOnWorkItems WorkItem[]               @relation("WorkItemWaitingOn")
  watching          WorkItemWatcher[]        @relation("WorkItemWatcherMember")
  personFieldValues CustomFieldValue[]       @relation("CustomFieldValuePerson")
  intakeNotify      IntakeNotifyMember[]     @relation("IntakeNotifyMembership")
  notificationPrefs NotificationPreference[]
  mentions          Mention[]                @relation("MentionMember")

  @@unique([tenantId, userId])
  /// The composite an FK from a tenant-scoped child references. `id` alone is
  /// already unique; this exists so Postgres accepts
  /// ([childFk, tenantId]) -> ([id, tenantId]), which makes a cross-tenant
  /// reference unrepresentable rather than merely filtered (ADR 0002).
  @@unique([id, tenantId])
  @@index([tenantId, status])
  /// "Which workspaces does THIS user belong to" without a scan:
  /// `@@unique([tenantId, userId])` leads with `tenantId`.
  @@index([userId, status])
  @@index([invitedByUserId])
  @@index([provisionedByOrgId])
  @@index([customRoleId])
}

/// A person's global sign-in identity, independent of any workspace.
model User {
  id             String    @id @default(cuid())
  /// The address, ENCRYPTED at rest (sub-phase 1.5). The PII extension
  /// (src/lib/security/pii-middleware.ts) writes ciphertext into this column,
  /// decrypts it on every read, and rewrites `where: { email }` to
  /// `emailHash`, so callers read and write plaintext. Not unique: the
  /// ciphertext has a random IV. The column keeps the field's name; it is
  /// never `@map`ped (ADR 0006 rule 3), where inflect-compliance maps it to
  /// `emailEncrypted`.
  email          String
  /// HMAC-SHA256 lookup hash of the normalised address, filled by the PII
  /// extension on every write. Nullable in the schema and NOT NULL in the
  /// database ON PURPOSE (inflect-compliance GAP-21): the schema's `?` keeps
  /// every create from having to name it, the database refuses a row without
  /// it. `tests/guards/pii-hash-not-null.test.ts` pins both halves; the drift
  /// residue carries the one line this leaves.
  emailHash      String?   @unique
  /// The display name, ENCRYPTED at rest by the same extension.
  name           String?
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenantMemberships  TenantMembership[]
  invitedMemberships TenantMembership[] @relation("MembershipInviter")
  orgMemberships     OrgMembership[]

  accounts            Account[]
  userSessions        UserSession[]        @relation("UserSessionOwner")
  passwordResetTokens PasswordResetToken[] @relation("UserPasswordResetTokens")
  mfaEnrollments      UserMfaEnrollment[]
  invitesSent         TenantInvite[]
  orgInvitesIssued    OrgInvite[]          @relation("OrgInviteInviter")

  auditLogs           AuditLog[]
  orgAuditLogActions  OrgAuditLog[] @relation("OrgAuditLogActor")
  orgAuditLogSubjects OrgAuditLog[] @relation("OrgAuditLogSubject")

  notifications Notification[]

  createdWorkItems         WorkItem[]         @relation("WorkItemCreator")
  createdWorkItemRelations WorkItemRelation[] @relation("WorkItemRelationCreator")
  createdWorkItemLinks     WorkItemLink[]     @relation("WorkItemLinkCreator")
  comments                 Comment[]          @relation("CommentAuthor")
  createdSavedViews        SavedView[]        @relation("SavedViewCreator")
}
