// ─────────────────────────────────────────────────────────────────
//  Notifications (sub-phase 1.6, docs/notifications.md)
//
//  Copied from inflect-compliance `prisma/schema/automation.prisma` at
//  5528464fc54a8681956f3b9ce23ca9c075f0420e (`Notification`,
//  `NotificationOutbox`, `TenantNotificationSettings`). Changes: the
//  workspace and user relations cascade; the bell index carries `createdAt`;
//  the outbox recipient is encrypted in place (no `toEmailEncrypted`
//  sibling); the BCC column is `bccMailbox` (was `complianceMailbox`) and the
//  bell's text is `body` (was `message`, a word ADR 0006 bans here);
//  `defaultFromName` defaults to "Islestone". `ReminderHistory` is not
//  ported (compliance evidence). Row-level security, grants and the
//  system-user CHECKs are in migration
//  `20261119150000_notifications_and_system_user`.
//
//  Sub-phase 2.7c (owner decisions 132 to 136) adds the Inbox's columns on
//  `Notification` (`readAt`, `archivedAt` for Done, `workItemId`) and
//  `NotificationPreference`, one row per member and type; inflect's unused
//  `UserNotificationPreference` was read as a pattern only. Migration
//  `20261204120200_inbox_and_preferences`.
// ─────────────────────────────────────────────────────────────────

/// An in-app notification: one row per recipient, shown by the bell and
/// pushed over the workspace's SSE stream. Per-USER within a workspace: RLS
/// scopes it to the workspace, and `NotificationRepository` adds the user
/// predicate (tests/integration/notification-per-user-scope.test.ts).
model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  type       NotificationType @default(GENERAL)
  /// Stored English at emit time (the bell cannot translate a stored row;
  /// sub-phase 2.7 decides whether to store keys instead).
  title      String
  /// The notification's text (inflect-compliance's `message`; ADR 0006 bans
  /// "Message" as a name for a Notification).
  body       String
  read       Boolean          @default(false)
  /// When the member last marked it read (2.7c); NULL for an unread row and
  /// for rows read before the column existed. The purge counts 180 days from
  /// it (from `createdAt` when NULL; owner decision 135).
  readAt     DateTime?
  /// When the member marked it Done (2.7c, ADR 0006: the Inbox's archive
  /// verb). NULL is in the Inbox; the purge deletes a Done row 90 days after
  /// this (owner decision 135).
  archivedAt DateTime?
  /// The work item it is about (2.7c), for the digest's visibility re-check.
  /// `(workItemId, tenantId)` → `WorkItem(id, tenantId)`, `ON DELETE SET NULL
  /// ("workItemId")` in SQL: a purged item leaves the row and its link. NULL
  /// for intake bells and rows written before the column existed.
  workItemId String?
  linkUrl    String?
  /// Optional idempotency key for job-generated notifications. Mirrors
  /// `NotificationOutbox.dedupeKey` — a unique key shaped
  /// `{tenantId}:{type}:{entityId}:{userId}:{YYYY-MM-DD}` so a job that
  /// re-runs (retry, redeploy) within the same UTC day trips the unique index
  /// instead of creating a duplicate. NULL for interactive writers.
  dedupeKey  String?          @unique
  createdAt  DateTime         @default(now())
  /// Cascades: a workspace purge (8.3) and a person's erasure take the bell
  /// rows with them.
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem   WorkItem?        @relation(fields: [workItemId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: NoAction)

  /// `listMine` orders by `createdAt desc` within one user's rows.
  @@index([tenantId, userId, createdAt])
  /// The Inbox's tabs: Unread and All are `archivedAt IS NULL`, Done is not.
  @@index([tenantId, userId, archivedAt, createdAt])
  /// The FK, and the digest's join to the item.
  @@index([tenantId, workItemId])
  /// The purge's two passes (owner decision 135).
  @@index([tenantId, archivedAt])
  @@index([tenantId, read, readAt])
}

/// A member's choice for one notification type (sub-phase 2.7c, owner
/// decision 132): the bell on or off, and email off, at once or in the daily
/// digest. No row means the type's default (`PREFERENCE_DEFAULTS` in
/// `src/lib/notifications/preferences.ts`). The workspace's
/// `TenantNotificationSettings` is the ceiling: a member's choice only
/// narrows it. `(tenantId, userId)` → `TenantMembership`, cascade: a removed
/// member's preferences go with the membership.
model NotificationPreference {
  tenantId      String
  userId        String
  type          NotificationType
  inApp         Boolean          @default(true)
  /// IMMEDIATE only for the types in `IMMEDIATE_EMAIL_TYPES`; the usecase
  /// refuses it elsewhere.
  emailDelivery EmailDelivery    @default(OFF)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, userId, type])
}

/// One outbound email, written in the transaction of the event that caused
/// it and sent later by `processOutbox` (claim before send).
model NotificationOutbox {
  id        String                @id @default(cuid())
  tenantId  String
  type      EmailNotificationType
  /// The recipient address, ENCRYPTED at rest in place by the PII extension
  /// (src/lib/security/pii-middleware.ts), like `User.email`.
  toEmail   String
  subject   String
  bodyText  String
  bodyHtml  String?
  /// A Reply-To for the message (2.6c: an emailed request's acknowledgement
  /// carries its reply address, so a reply threads onto the request). Our
  /// own intake address, not personal data.
  replyTo   String?
  status    EmailOutboxStatus     @default(PENDING)
  /// The claim's optimistic-concurrency token as well as the retry count.
  attempts  Int                   @default(0)
  lastError String?
  sendAfter DateTime              @default(now())
  createdAt DateTime              @default(now())
  sentAt    DateTime?
  /// Hashed recipient, never the raw address (`buildDedupeKey`).
  dedupeKey String                @unique
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, sendAfter])
  @@index([tenantId])
}

/// A workspace's notification preferences: whether email is sent at all, the
/// sender, the BCC copy, and the in-app types it has muted.
model TenantNotificationSettings {
  id               String             @id @default(cuid())
  tenantId         String             @unique
  /// Governs EMAIL only; the bell has `mutedInAppTypes`.
  enabled          Boolean            @default(true)
  defaultFromName  String             @default("Islestone")
  /// No @default, deliberately. This column is the `From` header processOutbox
  /// puts on every message for the workspace, so its value is a DEPLOYMENT
  /// fact and the application is the only thing that may decide it:
  /// `defaults()` in app-layer/notifications/settings.ts resolves it from
  /// SMTP_FROM via lib/email/sender-identity. Requiring the caller to supply
  /// it means an omission fails loudly instead of sending from a domain
  /// nobody verified. `defaultFromName` keeps its default because a product
  /// name is not a deployment fact and cannot be rejected by a relay.
  defaultFromEmail String
  /// The workspace's BCC copy of every message (inflect-compliance's
  /// `complianceMailbox`).
  bccMailbox       String?
  /// IN-APP (bell + SSE) mutes. A MUTE list rather than an enable list,
  /// because an absent member must mean "notify": adding a `NotificationType`
  /// never silently suppresses it for a workspace that saved its preferences
  /// before the member existed.
  mutedInAppTypes  NotificationType[] @default([])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────
//  Recipient lists (sub-phase 2.7e; docs/porting/maps/2.7.md, part 6;
//  owner decisions 79 and 138 to 142; ADR 0006 "Recipient list"). A named
//  set of people to notify: copied onto an item's watchers in one step
//  (decision 139), named by a project's intake beside its notify list
//  (decision 142), and resolved at send time by the later features that name
//  one. The stored membership is never "may receive": every send re-checks
//  the member, the project's visibility and the workspace
//  (`src/app-layer/notifications/recipient-list.ts`). Migration
//  `20261206120000_recipient_lists`.
// ─────────────────────────────────────────────────────────────────

/// A recipient list (ADR 0006): a workspace list (`projectId` NULL, managed
/// under `admin.manage`) or one project's (managed under `projects.edit`);
/// any member reads them (`projects.view`) (decision 140). The name is unique
/// in its scope, archived lists included (two partial uniques in the
/// migration). Archived and restored, never deleted (decision 141; `app_user`
/// holds no DELETE): only a project's or the workspace's cascade removes one.
model RecipientList {
  id          String    @id @default(cuid())
  tenantId    String
  /// NULL: a workspace list; set: a list of this project.
  projectId   String?
  /// Plaintext, sanitised, at most 80 characters.
  name        String
  /// Plaintext, sanitised, at most 500 characters.
  description String?
  archivedAt  DateTime?
  /// An actor stamp: a plain column, no FK.
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant          Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project?                         @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  members         RecipientListMember[]
  /// The project intakes that name this list (2.7e, decision 142).
  intakes         ProjectIntake[]
  /// The review steps that name this list (2.8a, decision 154).
  reviewSteps     WorkItemReviewStepList[]
  /// The default review steps of types that name this list (2.8c, decision 159).
  typeReviewSteps WorkItemTypeReviewStepReviewer[]
  /// The time tracking settings that name this list for submitted weeks (3.4c, decision 269).
  timeSettings    TenantTimeSettings[]

  @@unique([id, tenantId])
  @@index([tenantId, projectId, archivedAt])
}

/// One member of a recipient list: an ACTIVE member when added. Leaves with
/// the membership (the FK cascades: a removed member leaves every list) and
/// with the list's own cascade.
model RecipientListMember {
  tenantId  String
  listId    String
  userId    String
  /// An actor stamp: a plain column, no FK.
  addedById String
  createdAt DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  list   RecipientList    @relation(fields: [listId, tenantId], references: [id, tenantId], onDelete: Cascade)
  member TenantMembership @relation("RecipientListMembership", fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([listId, userId])
  @@index([tenantId, listId])
  @@index([tenantId, userId])
}
