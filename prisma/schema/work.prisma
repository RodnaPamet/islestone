// ─────────────────────────────────────────────────────────────────
//  Work: teams, workflows, projects, work items (sub-phases 2.1–2.2)
//
//  ADR 0002 (the work-item model) and ADR 0006 (names). Written fresh from
//  ADR 0002 §12; the composite parent keys follow inflect-compliance
//  `prisma/schema/tasks.prisma` lines 92–97 at
//  5528464fc54a8681956f3b9ce23ca9c075f0420e (Postgres runs foreign-key
//  checks as the table owner, which bypasses RLS, so a child that references
//  its parent by id alone could name another workspace's row; every child
//  here references `(parentId, tenantId)`).
//
//  Migration `20261119160000_work_core` holds what Prisma cannot declare, each
//  with a catalogue test (tests/integration/work-sql-constructs.test.ts):
//    - `COLLATE "C"` on every `sortKey` (ADR 0002 §5);
//    - the parent link `NO ACTION DEFERRABLE INITIALLY DEFERRED`;
//    - the relation CHECKs and the one-duplicate partial unique;
//    - the one-default-state partial unique, the workspace-label partial unique;
//    - the `workflow_state_category_immutable` trigger;
//    - row-level security and the grants for every table.
// ─────────────────────────────────────────────────────────────────

/// A group of members in a workspace. A team owns its workflow (its
/// `WorkflowState` rows) and its projects. Deleting a team is refused while
/// it has projects.
model Team {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  /// The unit the team estimates in (3.4a, owner decision 257): POINTS, HOURS,
  /// or NULL when it does not estimate (the default). Its items' estimate in
  /// the other unit is kept, hidden and uncounted; changing it moves no value.
  estimateUnit EstimateUnit?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowStates   WorkflowState[]
  projects         Project[]
  labels           Label[]
  cycleSchedule    CycleSchedule?
  cycles           Cycle[]
  /// The team's own working calendar, when it has one (roadmap 3.1a, ADR 0010 §5).
  workingCalendars WorkingCalendar[]
  /// Members whose capacity counts on this team's calendar (3.5a, decision 285).
  memberCapacities MemberCapacity[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
}

/// One named step in a team's workflow ("Status" in the UI, ADR 0006). The
/// category is fixed at creation (trigger `workflow_state_category_immutable`):
/// that is what lets `WorkItem.stateCategory` be held by a foreign key.
model WorkflowState {
  id         String                @id @default(cuid())
  tenantId   String
  teamId     String
  name       String
  category   WorkflowStateCategory
  /// Fractional index within the team (ADR 0002 §5); `COLLATE "C"` in SQL.
  sortKey    String
  /// Exactly one live default per team: the partial unique
  /// `WorkflowState_one_default_per_team` (SQL).
  isDefault  Boolean               @default(false)
  archivedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team      Team       @relation(fields: [teamId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([tenantId, teamId, name])
  /// Target of WorkItem's composite FK: a state of another team, or a stale
  /// category, cannot be stored on an item (ADR 0002 §10).
  @@unique([id, teamId, category, tenantId])
  @@index([tenantId, teamId, sortKey])
}

/// A body of work owned by one team, with its own key prefix. Soft delete
/// hides the project's items through the visibility predicate
/// (`projectVisibilityWhere`); the items' own `deletedAt` is not touched, so a
/// project restore brings every item back as it was.
model Project {
  id              String    @id @default(cuid())
  tenantId        String
  /// The project's team. NULL only on a tombstone (issue #120, owner decision
  /// 305): the purge clears it, so the team can be deleted (CHECK
  /// `Project_team_unless_tombstone`). A live or deleted project always has one.
  teamId          String?
  name            String
  /// The current prefix of the project's keys (`ISL` in `ISL-123`). Every
  /// prefix it has had is in `ProjectKeyPrefix`; no prefix is ever reused.
  keyPrefix       String
  /// The project's due date (roadmap 3.1, owner decision 188, ADR 0002 §16):
  /// date-only, optional, a deadline for the schedule and nothing else.
  dueDate         DateTime? @db.Date
  /// The initiative the project serves (sub-phase 3.2, ADR 0002 §2): at most
  /// one; `(initiativeId, tenantId)` → `Initiative(id, tenantId)`,
  /// `ON DELETE SET NULL ("initiativeId")` in SQL, so the purge (decision
  /// 219) clears the link. Kept while the initiative is soft-deleted.
  initiativeId    String?
  version         Int       @default(1)
  archivedAt      DateTime?
  deletedAt       DateTime?
  /// An actor stamp, like an audit row's user id: a plain column, no FK.
  deletedByUserId String?
  /// Set only on a tombstone (issue #117, owner decision 281): a deleted
  /// project the purge emptied but kept because time entries name it. It
  /// names no due date or initiative and is never restored (CHECK
  /// `Project_purged_is_tombstone`); only time totals read it.
  purgedAt        DateTime?
  /// New time entries on this project are billable unless the person unticks
  /// one (sub-phase 3.4d, owner decision 271); off unless set. Set under
  /// `time.rates`.
  timeBillableByDefault Boolean @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team                 Team?                 @relation(fields: [teamId, tenantId], references: [id, tenantId], onDelete: Restrict)
  initiative           Initiative?           @relation(fields: [initiativeId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: NoAction)
  workItems            WorkItem[]
  customFields         CustomField[]
  savedViews           SavedView[]
  milestones           Milestone[]
  workItemTemplates    WorkItemTemplate[]
  fieldSetEntries      WorkItemTypeField[]
  intake               ProjectIntake?
  intakeNotify         IntakeNotifyMember[]
  intakeForms          IntakeForm[]
  intakeRequests       IntakeRequest[]
  intakeBlockedSenders IntakeBlockedSender[]
  intakeInboundEmails  IntakeInboundEmail[]
  recipientLists       RecipientList[]
  /// Time recorded in this project (3.4b); kept when its item moves (decision 261).
  timeEntries          TimeEntry[]
  /// The project's billable rates (3.4d; decision 272).
  billableRates        BillableRate[]

  @@unique([id, tenantId])
  /// Target of WorkItem's composite FK: an item's team is its project's team.
  @@unique([id, teamId, tenantId])
  @@unique([tenantId, keyPrefix])
  @@index([tenantId, teamId])
  /// The initiative's FK, and an initiative's projects (3.2).
  @@index([tenantId, initiativeId])
  /// The purge sweep across every workspace (ADR 0002 §13's one exception).
  @@index([deletedAt])
}

/// Every prefix a project has had. The primary key makes a prefix unique in
/// the workspace for ever. No FK to `Project`: the row survives the
/// project's purge, so the prefix stays retired and old keys of moved items
/// keep resolving through `WorkItemKeyAlias`.
model ProjectKeyPrefix {
  tenantId  String
  prefix    String
  projectId String
  createdAt DateTime  @default(now())
  retiredAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, prefix])
  @@index([tenantId, projectId])
}

/// A project's key counter, incremented atomically (`INSERT … ON CONFLICT DO
/// UPDATE`) in the transaction that inserts the item, so a failed create
/// uses no number and numbers are never reused. The pattern of
/// inflect-compliance's `TaskKeySequence` (`tasks.prisma` lines 100–114),
/// scoped to a project. No FK to `Project`, for the reason on
/// `ProjectKeyPrefix`: key bookkeeping is never pruned.
model ProjectKeySequence {
  projectId String   @id
  tenantId  String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// A workspace-configured kind of work item (ADR 0002 §1). Types carry no
/// behaviour beyond their field set (2.4b-b) and their review defaults (2.8c).
/// An archived type is refused for new items and kept on old ones.
model WorkItemType {
  id                    String    @id @default(cuid())
  tenantId              String
  name                  String
  /// A key of the shared icon set, never a URL or markup.
  icon                  String?
  /// A token name or `#RRGGBB`.
  color                 String?
  /// Fractional index; `COLLATE "C"` in SQL.
  sortKey               String
  archivedAt            DateTime?
  /// Review must finish before an item of this type moves to Done (2.8c;
  /// ADR 0009 §14; owner decision 149). Cancelling is never held.
  reviewRequiredForDone Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItems       WorkItem[]
  templates       WorkItemTemplate[]
  fieldSetEntries WorkItemTypeField[]
  /// Its default review steps (2.8c, decision 159).
  reviewSteps     WorkItemTypeReviewStep[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
}

/// The single unit of tracked work (ADR 0002). Sub-items are work items
/// whose `parentId` names another item of the same project.
model WorkItem {
  id              String                @id @default(cuid())
  tenantId        String
  /// The project's team, held by the composite FK to `Project`.
  teamId          String
  projectId       String
  /// Key = `Project.keyPrefix` + "-" + number. Never reused.
  number          Int
  typeId          String
  /// Plaintext: searched, shown in notifications, quoted in commits.
  title           String
  /// ENCRYPTED (manifest `src/lib/security/encrypted-fields.ts`) and
  /// sanitised on write. Audit entries record that it changed, never its text.
  description     String?
  stateId         String
  /// Denormalised; held by the composite FK to `WorkflowState`.
  stateCategory   WorkflowStateCategory
  priority        WorkItemPriority      @default(NONE)
  /// The priority's place in the "urgent first" sort: URGENT 1 … LOW 4, NONE
  /// 5. Written only by the `work_item_priority_rank` trigger (sub-phase 2.4);
  /// Postgres orders the enum by declaration (NONE first).
  priorityRank    Int                   @default(5)
  /// The one accountable person (ADR 0003): a member, FK to
  /// `TenantMembership(tenantId, userId)`, ON DELETE RESTRICT.
  assigneeId      String?
  createdByUserId String
  /// `NO ACTION DEFERRABLE INITIALLY DEFERRED` in SQL, so a move updates a
  /// parent and its sub-items in one transaction.
  parentId        String?
  /// Fractional index; `COLLATE "C"` in SQL. Not part of `version`.
  sortKey         String
  startDate       DateTime?             @db.Date
  dueDate         DateTime?             @db.Date
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  /// Optimistic concurrency (ADR 0002 §9): every write that changes what the
  /// item shows increases it; `sortKey` does not.
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  /// An actor stamp: a plain column, no FK.
  deletedByUserId String?
  /// Rows deleted together share it, so a restore brings back exactly them.
  deletionId      String?
  /// The team's cycle the item is planned in (sub-phase 2.5). The composite
  /// FK `(cycleId, teamId, tenantId)` keeps it a cycle of the item's own team;
  /// a move to another team's project clears it in the same UPDATE.
  cycleId         String?
  /// The project's milestone the item belongs to (sub-phase 2.5b). The
  /// composite FK `(milestoneId, projectId, tenantId)` keeps it a milestone of
  /// the item's own project; a move to another project clears it in the same
  /// UPDATE.
  milestoneId     String?
  /// The repeat this item is an occurrence of (2.5d). The FK is
  /// `ON DELETE SET NULL ("recurrenceId")` in SQL: stopping a repeat leaves
  /// its earlier items in place.
  recurrenceId    String?
  /// The occurrence this item stands for (date-only); one item per
  /// `(recurrenceId, occurrenceOn)`, a partial unique in SQL.
  occurrenceOn    DateTime?             @db.Date
  /// Who must act next (2.4b, ADR 0002 §14): a member, FK to
  /// `TenantMembership(tenantId, userId)`, ON DELETE RESTRICT (member removal
  /// clears it first). Never accountable: the assignee is (ADR 0003 §1).
  /// Cleared by every move into DONE or CANCELLED (`stateTransitionEffects`);
  /// the CHECK `WorkItem_waiting_on_open_only` (SQL) refuses a closed item
  /// naming one. From 6.3 a nullable agent-session reference joins it, with a
  /// CHECK that at most one of the two is set (owner decision 106).
  waitingOnUserId String?
  /// The marked answer (2.4b-c, ADR 0002 §15; owner decisions 113 to 118):
  /// one live comment of this same item, by the composite FK
  /// `(answerCommentId, id, tenantId)` → `Comment(id, workItemId, tenantId)`,
  /// NO ACTION so the purge's cascade from item to comments passes. A person
  /// marks it (never an API key or agent); the trigger
  /// `comment_answer_not_deleted` (SQL) refuses soft-deleting the marked
  /// comment. Offered only where the item's field set shows the answer.
  answerCommentId String?
  /// The goal the item names directly (sub-phase 3.2a, owner decision 211):
  /// one goal of the workspace, set by a person, never inherited (a sub-item
  /// does not take its parent's). `(goalId, tenantId)` → `Goal(id, tenantId)`,
  /// `ON DELETE SET NULL ("goalId")` in SQL for the purge (decision 219). Kept
  /// on moves; not watched by the transition trigger.
  goalId          String?
  /// The estimate in points (3.4a, owner decision 257): a whole number, 0 to
  /// 100 (CHECK `WorkItem_estimate_points_range`). Shown, written and counted
  /// only while the item's team estimates in points; kept otherwise.
  estimatePoints  Int?
  /// The estimate in hours, stored as minutes, 0 to 60,000 (CHECK
  /// `WorkItem_estimate_minutes_range`). Shown, written and counted only
  /// while the item's team estimates in hours; kept otherwise. Both columns
  /// are watched by the transition trigger (decision 259).
  estimateMinutes Int?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId, teamId, tenantId], references: [id, teamId, tenantId], onDelete: Cascade)
  state          WorkflowState       @relation(fields: [stateId, teamId, stateCategory, tenantId], references: [id, teamId, category, tenantId], onDelete: Restrict)
  type           WorkItemType        @relation(fields: [typeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignee       TenantMembership?   @relation("WorkItemAssignee", fields: [tenantId, assigneeId], references: [tenantId, userId], onDelete: Restrict)
  waitingOn      TenantMembership?   @relation("WorkItemWaitingOn", fields: [tenantId, waitingOnUserId], references: [tenantId, userId], onDelete: Restrict)
  createdBy      User                @relation("WorkItemCreator", fields: [createdByUserId], references: [id])
  parent         WorkItem?           @relation("WorkItemParent", fields: [parentId, projectId, tenantId], references: [id, projectId, tenantId], onDelete: NoAction, onUpdate: NoAction)
  cycle          Cycle?              @relation(fields: [cycleId, teamId, tenantId], references: [id, teamId, tenantId], onDelete: Restrict, onUpdate: NoAction)
  milestone      Milestone?          @relation(fields: [milestoneId, projectId, tenantId], references: [id, projectId, tenantId], onDelete: NoAction, onUpdate: NoAction)
  answerComment  Comment?            @relation("WorkItemAnswer", fields: [answerCommentId, id, tenantId], references: [id, workItemId, tenantId], onDelete: NoAction, onUpdate: NoAction)
  goal           Goal?               @relation(fields: [goalId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: NoAction)
  subItems       WorkItem[]          @relation("WorkItemParent")
  recurrence     WorkItemRecurrence? @relation("RecurrenceOccurrences", fields: [recurrenceId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: NoAction)
  recurrenceRule WorkItemRecurrence? @relation("RecurrenceSource")

  relationsFrom     WorkItemRelation[]    @relation("WorkItemRelationFrom")
  relationsTo       WorkItemRelation[]    @relation("WorkItemRelationTo")
  labels            WorkItemLabel[]
  comments          Comment[]
  watchers          WorkItemWatcher[]
  links             WorkItemLink[]
  customFieldValues CustomFieldValue[]
  notifications     Notification[]
  mentions          Mention[]
  searchVectors     SearchVector[]
  /// Its review rounds and reviewer rows (2.8a, ADR 0009).
  reviewRounds      WorkItemReviewRound[]
  reviewers         WorkItemReviewer[]
  /// Time recorded on it (3.4b, ADR 0012).
  timeEntries       TimeEntry[]

  @@unique([tenantId, projectId, number])
  @@unique([id, tenantId])
  /// Target of the parent link: a parent in another project cannot be stored.
  @@unique([id, projectId, tenantId])
  // List indexes, ADR 0002 §13 (each backs a named query).
  @@index([tenantId, projectId, sortKey, id])
  @@index([tenantId, projectId, stateId, sortKey])
  @@index([tenantId, teamId, stateCategory, sortKey])
  @@index([tenantId, assigneeId, stateCategory, dueDate])
  /// The waiting-on filter, its lanes and My Work's "waiting on me" (2.4b, 2.7).
  @@index([tenantId, waitingOnUserId, stateCategory, dueDate])
  @@index([tenantId, parentId, sortKey])
  @@index([tenantId, createdByUserId, createdAt])
  @@index([tenantId, projectId, updatedAt, id])
  // The list sorts of sub-phase 2.4 (docs/pagination.md).
  @@index([tenantId, projectId, createdAt, id])
  @@index([tenantId, projectId, dueDate, id])
  @@index([tenantId, projectId, priorityRank, id])
  @@index([tenantId, sortKey, id])
  @@index([tenantId, assigneeId, sortKey, id])
  @@index([tenantId, dueDate, id])
  @@index([tenantId, stateCategory, dueDate])
  @@index([tenantId, typeId])
  /// Deleting or merging a state finds its items across projects.
  @@index([tenantId, stateId])
  @@index([tenantId, deletionId])
  /// The cycle page, its counts and the rollover (ADR 0002 §13).
  @@index([tenantId, cycleId, stateCategory])
  /// The milestones page's progress and the milestone filter (ADR 0002 §13).
  @@index([tenantId, milestoneId, stateCategory])
  /// A repeat's occurrences (stopping a repeat, the series mark).
  @@index([tenantId, recurrenceId])
  /// The marked answer's FK (2.4b-c): the comment trigger's lookup.
  @@index([tenantId, answerCommentId])
  /// The direct goal's FK, the `goalId` filter and a goal's direct-item count (3.2).
  @@index([tenantId, goalId, stateCategory])
  /// A project's live, non-cancelled items by category (an initiative's and a
  /// goal's progress, 3.2b) is the partial `WorkItem_progress_project_path`,
  /// in migration `20261216120000_work_item_progress_index` only: Prisma
  /// cannot declare its predicate.
  /// The purge sweep across every workspace (ADR 0002 §13's one exception).
  @@index([deletedAt])
}

/// The old key of an item that moved to another project (ADR 0002 §4). No
/// FK: key bookkeeping survives the purge, and a lookup that reaches a
/// purged item answers 404.
model WorkItemKeyAlias {
  tenantId   String
  projectId  String
  number     Int
  workItemId String
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, projectId, number])
  @@index([tenantId, workItemId])
}

/// A typed link between two work items (ADR 0002 §6). BLOCKS is directed;
/// RELATES is stored once with `fromId < toId`; DUPLICATES points from the
/// duplicate to the original. The index column order differs from the ADR
/// sketch so both foreign keys sit second after `tenantId` (ADR 0002 §13).
model WorkItemRelation {
  id              String               @id @default(cuid())
  tenantId        String
  type            WorkItemRelationType
  fromId          String
  toId            String
  createdByUserId String
  createdAt       DateTime             @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  from      WorkItem @relation("WorkItemRelationFrom", fields: [fromId, tenantId], references: [id, tenantId], onDelete: Cascade)
  to        WorkItem @relation("WorkItemRelationTo", fields: [toId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User     @relation("WorkItemRelationCreator", fields: [createdByUserId], references: [id])

  @@unique([tenantId, fromId, type, toId])
  @@index([tenantId, toId, type])
  @@index([tenantId, createdByUserId])
}

/// A workspace-defined label, optionally limited to one team.
model Label {
  id                String    @id @default(cuid())
  tenantId          String
  /// NULL: a workspace label.
  teamId            String?
  name              String
  color             String?
  /// Fractional index; `COLLATE "C"` in SQL.
  sortKey           String
  /// Set while a delete detaches the label; attach refuses it (409).
  deletionStartedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team      Team?                   @relation(fields: [teamId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workItems WorkItemLabel[]
  templates WorkItemTemplateLabel[]

  @@unique([id, tenantId])
  @@unique([tenantId, teamId, name])
  @@index([tenantId, teamId])
}

/// A label on a work item.
model WorkItemLabel {
  tenantId   String
  workItemId String
  labelId    String
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [workItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  label    Label    @relation(fields: [labelId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([workItemId, labelId])
  @@index([tenantId, labelId, workItemId])
}

/// A person's comment on a work item. `body` is ENCRYPTED (manifest) and
/// sanitised on write; a delete is soft.
model Comment {
  id           String    @id @default(cuid())
  tenantId     String
  workItemId   String
  authorUserId String
  body         String
  editedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem      WorkItem       @relation(fields: [workItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  author        User           @relation("CommentAuthor", fields: [authorUserId], references: [id])
  /// The item that marks this comment as its answer (2.4b-c); at most one,
  /// and only the comment's own item (the FK names the item's id).
  answerOf      WorkItem[]     @relation("WorkItemAnswer")
  /// The people this comment mentions (2.7d).
  mentions      Mention[]
  /// Its search vector (2.7f), removed when it is deleted.
  searchVectors SearchVector[]

  /// Target of the answer link: another item's comment cannot be stored.
  @@unique([id, workItemId, tenantId])
  @@index([tenantId, workItemId, createdAt])
  @@index([tenantId, authorUserId])
}

/// The full-text search vector of one encrypted text (sub-phase 2.7f, ADR
/// 0008 D1, owner decision 124): a work item's description (`commentId` NULL)
/// or one live comment's body. `lexemes` is a PLAINTEXT derivative of those
/// encrypted fields: the stemmed words of the text with their positions,
/// readable in the database, its dumps and its backups by decision 124. Built
/// with `configName` (`islestone_bg_en`, CHECKed) at `revision`; the
/// `search-index-rebuild` job rewrites older revisions. One row per source
/// (two partial uniques in the migration, with the tenant-leading GIN index
/// over `lexemes`, partial on `configName`, which Prisma cannot declare). Written only by `SearchVectorRepository`, in the
/// transaction that writes the text; the item, the comment and the workspace
/// cascade.
model SearchVector {
  id         String                  @id @default(cuid())
  tenantId   String
  workItemId String
  commentId  String?
  lexemes    Unsupported("tsvector")
  configName String
  revision   Int
  updatedAt  DateTime                @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [workItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId, workItemId, tenantId], references: [id, workItemId, tenantId], onDelete: Cascade)

  @@index([tenantId, workItemId])
  @@index([tenantId, commentId])
  /// The rebuild's page: rows built at an older revision.
  @@index([tenantId, revision])
}

/// A person mentioned in a comment or in a work item's description (sub-phase
/// 2.7d, owner decisions 127 to 130). The rows, not the text, are the
/// authority: a `<@userId>` token renders as a chip only when its source has a
/// row for that person, so a token typed by an outsider, copied by a template
/// or a repeat, or pasted from elsewhere names nobody and notifies nobody.
/// `commentId` NULL is the item's description. One row per source and person
/// (two partial uniques in the migration). The item and the comment cascade,
/// and so does the membership: a removed member's mentions go and render as
/// plain text. `mentionedById` is an actor stamp, a plain column with no FK.
model Mention {
  id              String   @id @default(cuid())
  tenantId        String
  workItemId      String
  commentId       String?
  mentionedUserId String
  mentionedById   String
  createdAt       DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem WorkItem         @relation(fields: [workItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  comment  Comment?         @relation(fields: [commentId, workItemId, tenantId], references: [id, workItemId, tenantId], onDelete: Cascade)
  member   TenantMembership @relation("MentionMember", fields: [tenantId, mentionedUserId], references: [tenantId, userId], onDelete: Cascade)

  /// "Mentioned you", newest first, per person.
  @@index([tenantId, mentionedUserId, createdAt])
  @@index([tenantId, workItemId])
  @@index([tenantId, commentId])
}

/// A member watching a work item. The member FK cascades: a removed member
/// stops watching.
model WorkItemWatcher {
  tenantId   String
  workItemId String
  userId     String
  createdAt  DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem WorkItem         @relation(fields: [workItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  member   TenantMembership @relation("WorkItemWatcherMember", fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([workItemId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, workItemId])
}

/// A reference from a work item to something that is not a work item: a URL,
/// pull request, commit, page or canvas (ADR 0006 "Link"). `type` is one of
/// `WORK_ITEM_LINK_TYPES`, validated in the usecase; `location` is the URL
/// (or, from 4.1/4.2, the page or canvas id). ADR 0002's sketch names them
/// `kind` and `target`, two words ADR 0006 bans in the schema ("Kind" for a
/// type, "Target" for a goal); the sketch is illustrative.
model WorkItemLink {
  id              String   @id @default(cuid())
  tenantId        String
  workItemId      String
  type            String
  location        String
  title           String?
  createdByUserId String
  createdAt       DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem  WorkItem @relation(fields: [workItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User     @relation("WorkItemLinkCreator", fields: [createdByUserId], references: [id])

  @@index([tenantId, workItemId])
  @@index([tenantId, createdByUserId])
}

// ─────────────────────────────────────────────────────────────────
//  Custom fields and saved views (sub-phase 2.4)
//
//  ADR 0002 §7 and ADR 0006; docs/porting/maps/2.4.md. Migration
//  `20261120120000_saved_views_and_custom_fields` holds what Prisma cannot
//  declare, each with a catalogue test
//  (tests/integration/custom-field-sql-constructs.test.ts): `COLLATE "C"` on
//  both `sortKey`s, the one-column CHECK and the text cap on
//  `CustomFieldValue`, its two partial uniques, the priority-rank trigger,
//  row-level security and the grants.
// ─────────────────────────────────────────────────────────────────

/// A typed field a project defines ("Field" in the UI). The type never
/// changes (the value rows' composite FK holds it); a field is archived,
/// never deleted, and an archived field keeps its values.
model CustomField {
  id         String          @id @default(cuid())
  tenantId   String
  projectId  String
  name       String
  type       CustomFieldType
  /// Fractional index within the project; `COLLATE "C"` in SQL.
  sortKey    String
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         Project             @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  options         CustomFieldOption[]
  values          CustomFieldValue[]
  fieldSetEntries WorkItemTypeField[]

  @@unique([id, tenantId])
  /// Target of the value's composite FK: a value carries its field's type and
  /// project, so neither can disagree with the field.
  @@unique([id, type, projectId, tenantId])
  /// Target of a field-set rule's composite FK (2.4b-b): a rule names a field
  /// of its own project.
  @@unique([id, projectId, tenantId])
  @@unique([tenantId, projectId, name])
  @@index([tenantId, projectId, sortKey])
}

/// One choice of a SELECT or MULTI_SELECT field. An archived option stays
/// valid on the items that hold it and in filters; it cannot be newly picked.
/// A value holding it refuses its delete (FK NO ACTION).
model CustomFieldOption {
  id         String    @id @default(cuid())
  tenantId   String
  fieldId    String
  name       String
  /// A token name or `#RRGGBB`.
  color      String?
  /// Fractional index within the field; `COLLATE "C"` in SQL.
  sortKey    String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  field  CustomField        @relation(fields: [fieldId, tenantId], references: [id, tenantId], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([id, tenantId])
  /// Target of the value's option FK: an option of another field cannot be stored.
  @@unique([id, fieldId, tenantId])
  @@unique([tenantId, fieldId, name])
  @@index([tenantId, fieldId, sortKey])
}

/// One value of one field on one item, in the column of the field's type
/// (ADR 0002 §7): a CHECK requires exactly that column. A MULTI_SELECT holds
/// one row per chosen option; a CHECKBOX stores only `true` (unchecked is no
/// row). TEXT and URL values are PLAINTEXT, because they are filtered and
/// sorted (ADR 0002 §7, "Consequences"), and capped at 500 characters.
///
/// `projectId` is the item's and the field's: both composite FKs carry it, so
/// a value can never sit on another project's item, and an item cannot change
/// project while it holds values (`ON UPDATE NO ACTION`): a move deletes them.
model CustomFieldValue {
  id          String          @id @default(cuid())
  tenantId    String
  projectId   String
  workItemId  String
  fieldId     String
  fieldType   CustomFieldType
  textValue   String?
  numberValue Decimal?        @db.Decimal(15, 6)
  dateValue   DateTime?       @db.Date
  boolValue   Boolean?
  optionId    String?
  /// A PERSON value: a member, FK to `TenantMembership(tenantId, userId)`,
  /// NO ACTION on delete (removing the member clears it first, as the assignee).
  userId      String?
  createdAt   DateTime        @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workItem WorkItem           @relation(fields: [workItemId, projectId, tenantId], references: [id, projectId, tenantId], onDelete: Cascade, onUpdate: NoAction)
  field    CustomField        @relation(fields: [fieldId, fieldType, projectId, tenantId], references: [id, type, projectId, tenantId], onDelete: Cascade, onUpdate: NoAction)
  option   CustomFieldOption? @relation(fields: [optionId, fieldId, tenantId], references: [id, fieldId, tenantId], onDelete: NoAction, onUpdate: NoAction)
  member   TenantMembership?  @relation("CustomFieldValuePerson", fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, workItemId])
  @@index([tenantId, projectId])
  @@index([tenantId, optionId])
  @@index([tenantId, userId])
  // Filters and sorts by a field (ADR 0002 §13: `[tenantId, fieldId, <value column>]`).
  @@index([tenantId, fieldId, textValue])
  @@index([tenantId, fieldId, numberValue])
  @@index([tenantId, fieldId, dateValue])
  @@index([tenantId, fieldId, boolValue])
  @@index([tenantId, fieldId, optionId])
  @@index([tenantId, fieldId, userId])
}

/// A saved scope, filters, grouping, sorting, layout and visible columns
/// ("View" in the UI, ADR 0006). PERSONAL: its creator's alone. SHARED: every
/// member who sees its scope. `projectId` NULL is the workspace's Work items
/// page. `configJson` is validated on every write
/// (`SavedViewConfigSchema`, `src/lib/schemas/saved-view.ts`).
model SavedView {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  visibility      SavedViewVisibility
  projectId       String?
  layout          ViewLayout          @default(LIST)
  configJson      Json
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User     @relation("SavedViewCreator", fields: [createdByUserId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, createdByUserId, projectId])
  @@index([tenantId, visibility, projectId])
  @@index([tenantId, projectId])
}

// ─────────────────────────────────────────────────────────────────
//  Cycles and transitions (sub-phase 2.5a)
//
//  docs/porting/maps/2.5.md; owner decisions 62 to 75. Migration
//  `20261121120000_cycles_and_transitions` holds what Prisma cannot declare,
//  each with a catalogue test (tests/integration/cycles-sql-constructs.test.ts):
//  the no-overlap exclusion constraint, the CHECKs, the transition trigger and
//  the privileges that make it the table's only writer.
// ─────────────────────────────────────────────────────────────────

/// A team's rule for making cycles (ADR 0006 "Cycle schedule"). One row per
/// team, made the first time someone saves the team's cycle settings. While
/// `enabled`, the `cycle-rollover` job keeps `upcomingCount` cycles after the
/// current one; `rollover` applies whether or not the schedule is enabled.
model CycleSchedule {
  id            String        @id @default(cuid())
  tenantId      String
  teamId        String
  enabled       Boolean       @default(true)
  /// 1 to 8 (CHECK).
  lengthWeeks   Int           @default(2)
  /// The first cycle's start; every scheduled cycle starts a whole number of
  /// lengths after it.
  firstStartsOn DateTime      @db.Date
  /// 1 to 6 (CHECK).
  upcomingCount Int           @default(2)
  rollover      CycleRollover @default(NEXT_CYCLE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One per team; also the target the one-to-one relation needs.
  @@unique([teamId, tenantId])
  @@index([tenantId, teamId])
}

/// A time-boxed period of one team (ADR 0006 "Cycle"). Cycles of a team never
/// overlap (the exclusion constraint `Cycle_no_overlap`). Status is derived
/// from the dates and `completedAt`, never stored.
model Cycle {
  id           String    @id @default(cuid())
  tenantId     String
  teamId       String
  /// The team's next number, under the team's cycle lock.
  number       Int
  /// Optional; shown as "Cycle <number>" when absent. Plaintext, sanitised.
  name         String?
  startsOn     DateTime  @db.Date
  endsOn       DateTime  @db.Date
  /// Made by the team's schedule (the schedule may replace it while it is
  /// upcoming and empty), as against a one-off cycle a person made.
  fromSchedule Boolean   @default(false)
  /// Set once, by the rollover that closes the cycle.
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team      Team       @relation(fields: [teamId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([id, tenantId])
  /// Target of WorkItem's composite FK: a cycle of another team cannot be stored.
  @@unique([id, teamId, tenantId])
  @@unique([tenantId, teamId, number])
  @@index([tenantId, teamId, startsOn])
  /// The rollover's scan: open cycles by end date.
  @@index([tenantId, completedAt, endsOn])
}

/// One recorded change to a work item's state, cycle, milestone, project, waiting on or deletion
/// (ADR 0006 "Transition"). Written ONLY by the trigger
/// `work_item_transition_record` (SECURITY DEFINER; `app_user` holds SELECT
/// alone), each row the item's picture after the change; read by the burn-up
/// and, from 3.6, by analytics. No FK to `WorkItem`: the rows outlive an
/// item's purge and go with the workspace (owner decision 66).
model WorkItemTransition {
  id              BigInt                @id @default(autoincrement())
  tenantId        String
  workItemId      String
  projectId       String
  teamId          String
  stateId         String
  stateCategory   WorkflowStateCategory
  cycleId         String?
  /// Since 2.5b; NULL in rows written before.
  milestoneId     String?
  /// Since 2.4b (owner decision 107); NULL in rows written before. 3.6 counts
  /// time waiting from these rows.
  waitingOnUserId String?
  /// Since 3.4a (owner decision 259); NULL in rows written before. The burn-up's
  /// Points and Hours measures read them.
  estimatePoints  Int?
  estimateMinutes Int?
  deleted         Boolean
  at              DateTime              @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, cycleId, workItemId])
  @@index([tenantId, workItemId, at])
  @@index([tenantId, projectId, at])
}

// ─────────────────────────────────────────────────────────────────
//  Milestones (sub-phase 2.5b)
//
//  docs/porting/maps/2.5.md; owner decisions 62 and 71–74. Migration
//  `20261122120000_milestones` holds `COLLATE "C"` on `sortKey`, RLS, the grant
//  and the transition trigger's new column, each with a catalogue test
//  (tests/integration/milestones.test.ts).
// ─────────────────────────────────────────────────────────────────

/// A named group of one project's work items with a due date (ADR 0006
/// "Milestone"; the date is `dueDate` because "Target" is banned). Progress is
/// derived from its items, never stored. Deleting one clears its items first
/// (the item FK is RESTRICT).
model Milestone {
  id        String    @id @default(cuid())
  tenantId  String
  projectId String
  /// Plaintext, sanitised; unique in the project.
  name      String
  /// Date-only; optional.
  dueDate   DateTime? @db.Date
  /// Fractional index within the project (ADR 0002 §5); `COLLATE "C"` in SQL.
  sortKey   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workItems WorkItem[]

  @@unique([id, tenantId])
  /// Target of WorkItem's composite FK: a milestone of another project cannot be stored.
  @@unique([id, projectId, tenantId])
  @@unique([tenantId, projectId, name])
  @@index([tenantId, projectId, sortKey])
}

/// An item template (sub-phase 2.5c, owner decisions 71 and 73): what a new
/// work item of the project starts from. Managed under `projects.edit`.
/// `description` is ENCRYPTED (manifest) and sanitised before it is stored;
/// `name` and `title` are plaintext, like an item's title. The type, labels,
/// assignee, custom-field values and sub-items are checked against the
/// project at save and again at use (`templateToCreateInput`).
model WorkItemTemplate {
  id                    String           @id @default(cuid())
  tenantId              String
  projectId             String
  /// Plaintext, sanitised; unique in the project.
  name                  String
  title                 String
  description           String?
  typeId                String?
  priority              WorkItemPriority @default(NONE)
  /// A member's user id, checked at save and at use; no FK (a removed member is cleared, `removeTenantMember`).
  assigneeId            String?
  /// The new item's due date, this many days after the day it is created (0 to 3650).
  dueInDays             Int?
  /// The new item's estimate (3.4a, owner decision 258), in the unit its
  /// project's team used when it was saved; a use under another unit skips it,
  /// named `estimate:unit`. The same CHECKed ranges as the item's.
  estimatePoints        Int?
  estimateMinutes       Int?
  /// Field id → value, as `customFields` on a create.
  customFieldValuesJson Json?
  /// The sub-items made with the item: `[{ title }]`.
  subItemsJson          Json?
  /// Fractional index within the project; `COLLATE "C"` in SQL.
  sortKey               String
  archivedAt            DateTime?
  /// Who made it (an actor stamp; no FK).
  createdByUserId       String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project                 @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  type    WorkItemType?           @relation(fields: [typeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  labels  WorkItemTemplateLabel[]

  @@unique([id, tenantId])
  @@unique([tenantId, projectId, name])
  @@index([tenantId, projectId, sortKey])
  @@index([tenantId, typeId])
}

/// A label an item template puts on its items; goes with the template or the label.
model WorkItemTemplateLabel {
  tenantId   String
  templateId String
  labelId    String
  createdAt  DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template WorkItemTemplate @relation(fields: [templateId, tenantId], references: [id, tenantId], onDelete: Cascade)
  label    Label            @relation(fields: [labelId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([templateId, labelId])
  @@index([tenantId, templateId])
  @@index([tenantId, labelId])
}

/// A project template (sub-phase 2.5c, owner decisions 71 and 73): the
/// workspace's starting point for a new project, made from an existing one
/// ("Save as template", `admin.manage`) and used under `projects.create`.
/// `contentJson` is the whole content (fields, milestones, item templates,
/// starter items), a versioned, Zod-validated document ENCRYPTED under the
/// workspace key (manifest); `name` is plaintext.
model ProjectTemplate {
  id              String    @id @default(cuid())
  tenantId        String
  /// Plaintext, sanitised; unique in the workspace.
  name            String
  contentJson     String
  contentVersion  Int       @default(1)
  /// Fractional index within the workspace; `COLLATE "C"` in SQL.
  sortKey         String
  archivedAt      DateTime?
  /// Who saved it (an actor stamp; no FK).
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, sortKey])
}

/// A repeat (sub-phase 2.5d, owner decisions 67 to 70): the rule on the item
/// where it was set. The nightly `work-item-recurrence` job makes each
/// occurrence `leadDays` before it is due, as `ownerUserId` re-resolved,
/// claiming the stamped `nextOccurrenceOn` in the create's transaction.
/// Dates are date-only. The rule goes with its item (cascade).
model WorkItemRecurrence {
  id               String              @id @default(cuid())
  tenantId         String
  sourceWorkItemId String
  frequency        RecurrenceFrequency
  /// Every N days, weeks, months or years: 1 to 99 (a CHECK).
  interval         Int                 @default(1)
  /// Weekly only: 0 (Sunday) to 6 (Saturday) (a CHECK).
  weekdays         Int[]
  /// The series' first date: the item's due date when the repeat was set.
  firstOn          DateTime            @db.Date
  endsOn           DateTime?           @db.Date
  /// The number of times, the item itself counted: 2 to 1000 (a CHECK).
  maxOccurrences   Int?
  /// Days before an occurrence is due that it is made: 0 to 30 (a CHECK).
  leadDays         Int                 @default(3)
  /// The occurrence the rule waits for; null once it has ended.
  nextOccurrenceOn DateTime?           @db.Date
  /// How many occurrences the job has made.
  occurrenceCount  Int                 @default(0)
  /// Who the job acts as: whoever last set or resumed the repeat (an actor stamp; no FK).
  ownerUserId      String
  heldAt           DateTime?
  heldReason       RecurrenceHold?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      WorkItem   @relation("RecurrenceSource", fields: [sourceWorkItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  occurrences WorkItem[] @relation("RecurrenceOccurrences")

  @@unique([id, tenantId])
  /// One repeat per item.
  @@unique([sourceWorkItemId, tenantId])
  /// The job's scan.
  @@index([tenantId, nextOccurrenceOn])
}

// ─────────────────────────────────────────────────────────────────
//  Field sets (sub-phase 2.4b-b)
//
//  docs/porting/maps/2.4b.md; ADR 0002 §1 and §7; owner decisions 101 and
//  108 to 112. Migration `20261130120100_field_sets` holds the CHECKs, the
//  two partial uniques, RLS and the grant, with a catalogue test
//  (tests/integration/field-sets.test.ts).
// ─────────────────────────────────────────────────────────────────

/// One field's rule in a work item type's field set (ADR 0006 "Field set"):
/// a built-in field's rule belongs to the type across the workspace
/// (`projectId` NULL, managed under `admin.manage`); a custom field's belongs
/// to the type within the field's project (managed under `projects.edit`).
/// Exactly one of `builtInField` and `customFieldId` (a CHECK); a field with
/// no row is OPTIONAL, the answer HIDDEN (`src/lib/work-items/field-sets.ts`).
model WorkItemTypeField {
  id            String           @id @default(cuid())
  tenantId      String
  typeId        String
  /// NULL for a built-in field's rule; the custom field's project otherwise.
  projectId     String?
  /// One of `CONFIGURABLE_BUILT_IN_FIELDS` (a CHECK lists them).
  builtInField  String?
  customFieldId String?
  requirement   FieldRequirement
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        WorkItemType @relation(fields: [typeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customField CustomField? @relation(fields: [customFieldId, projectId, tenantId], references: [id, projectId, tenantId], onDelete: Cascade)

  @@index([tenantId, typeId])
  @@index([tenantId, projectId, typeId])
  @@index([tenantId, customFieldId])
}
