// Every enum in the schema lives here (prisma/schema/README.md, "Enum
// policy"). Names and values follow ADR 0006 (docs/adr/0006-vocabulary.md).
//
// Adding a value to an enum is a migration of its own: a bare
// `ALTER TYPE … ADD VALUE` never shares a migration with other DDL
// (tests/guards/migration-enum-isolation.test.ts). Declaration order is
// physical order, and tests/guards/enum-member-order-matches-migrations.test.ts
// holds the two equal.

/// A workspace membership's role (ADR 0006, decided by the owner on
/// 2026-11-18). Declared in seniority order, Owner > Admin > Member >
/// Viewer > Guest, because code that looks for the most senior member
/// sorts `TenantMembership.role` ascending. A role that cannot be resolved
/// falls back to VIEWER, never GUEST.
enum Role {
  /// OWNER — workspace lifecycle and owner management. The last ACTIVE
  /// OWNER of a workspace cannot be removed or demoted (DB trigger
  /// `tenant_membership_last_owner_guard`; the usecase guard arrives with
  /// member management in sub-phase 1.4).
  OWNER
  ADMIN
  MEMBER
  VIEWER
  GUEST
}

/// An organization membership's role. Compare roles through
/// `src/lib/org-roles.ts`, never with a literal 'ORG_ADMIN'. The last
/// ORG_OWNER of an organization cannot be removed or demoted (DB trigger
/// `org_membership_last_owner_guard`).
enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_READER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DEACTIVATED
  REMOVED
}

/// A workspace's MFA policy (sub-phase 1.4). Copied verbatim from
/// inflect-compliance.
enum MfaPolicy {
  DISABLED
  OPTIONAL
  REQUIRED
}

/// MFA factor kind. TOTP only.
enum MfaType {
  TOTP
}

/// Organization audit actions, stored by `OrgAuditLog` (sub-phase 1.5).
/// Sub-phase 1.4 created the enum because it landed first. The nine values
/// of docs/porting/maps/1.5.md.
enum OrgAuditAction {
  ORG_MEMBER_ADDED
  ORG_MEMBER_REMOVED
  ORG_MEMBER_ROLE_CHANGED
  ORG_ADMIN_PROVISIONED_TO_TENANTS
  ORG_ADMIN_DEPROVISIONED_FROM_TENANTS
  ORG_INVITE_CREATED
  ORG_INVITE_REDEEMED
  ORG_INVITE_REVOKED
  ORG_AUTHZ_DENIED
}

/// The state of an `AuditOutbox` row (sub-phase 1.5): queued, drained onto
/// the hash chain, or given up on after the drain's attempts.
enum AuditOutboxStatus {
  PENDING
  APPLIED
  FAILED
}

/// The kind of an in-app `Notification` (sub-phase 1.6). Sub-phase 2.2 adds
/// `WORK_ITEM_DUE` with the due reminder, 2.7 the mention types, Phase 6 the
/// agent types. A value is added in a migration of its own, and a reader
/// ships before its first writer.
enum NotificationType {
  GENERAL
  WORK_ITEM_ASSIGNED
  WORK_ITEM_WATCH_UPDATE
  WORK_ITEM_DUE
  /// Sub-phase 2.6a: a new intake request, to the project's notify list.
  INTAKE_REQUEST_RECEIVED
  /// Sub-phase 2.6a: a snoozed request came back, to whoever snoozed it.
  INTAKE_REQUEST_WOKEN
  /// Sub-phase 2.4b: someone named you as the person a work item waits on
  /// (owner decision 105).
  WORK_ITEM_WAITING_ON
  /// Sub-phase 2.7d: someone mentioned you in a comment or a description
  /// (owner decisions 127 to 130).
  WORK_ITEM_MENTIONED
  /// Sub-phase 2.8a: a review step you are a reviewer of opened, or you were
  /// added to an open one; also the "no reviewers left" notice to the item's
  /// assignee and whoever sent the round (owner decision 161).
  WORK_ITEM_REVIEW_REQUESTED
  /// Sub-phase 2.8a: a review step waiting on you is due or overdue, from the
  /// 08:00 due job (decision 161).
  WORK_ITEM_REVIEW_DUE
  /// Sub-phase 2.8a: a reviewer returned a work item, to its assignee and
  /// whoever sent the round (decision 161).
  WORK_ITEM_REVIEW_RETURNED
  /// Sub-phase 2.8a: a review round completed, to the item's assignee and
  /// whoever sent the round (decision 161).
  WORK_ITEM_REVIEW_COMPLETED
}

/// The kind of an outbound email in `NotificationOutbox` (sub-phase 1.6).
enum EmailNotificationType {
  WORK_ITEM_ASSIGNED
  /// Retired in sub-phase 2.7c (owner decision 133): nothing writes it; the
  /// daily `NOTIFICATION_DIGEST` replaced it. The value stays because Postgres
  /// cannot drop an enum value without recreating the type.
  DUE_DIGEST
  /// Sub-phase 2.6b: the one email asking a public form's requester to
  /// confirm their address (owner decision 89).
  INTAKE_CONFIRM_ADDRESS
  /// Sub-phase 2.6b: a confirmed requester's request was accepted.
  INTAKE_ACCEPTED
  /// Sub-phase 2.6b: a confirmed requester's request was declined (never
  /// sent for spam).
  INTAKE_DECLINED
  /// Sub-phase 2.6b: a confirmed requester's request is handled together
  /// with another.
  INTAKE_MERGED
  /// Sub-phase 2.6c: an emailed request was received; only to a sender whose
  /// domain authentication passed (decision 123).
  INTAKE_RECEIVED_ACK
  /// Sub-phase 2.7c: someone named you as the person a work item waits on,
  /// mailed at once when your preference says so (owner decision 132).
  WORK_ITEM_WAITING_ON
  /// Sub-phase 2.7c: the one daily email with the day's notifications and due
  /// work items (owner decision 133). Replaces `DUE_DIGEST`.
  NOTIFICATION_DIGEST
  /// Sub-phase 2.7d: someone mentioned you, mailed at once when your
  /// preference says so (owner decisions 128 and 130; the default).
  WORK_ITEM_MENTIONED
  /// Sub-phase 2.8a: a review was requested of you, mailed at once when your
  /// preference says so (owner decision 161; the default).
  WORK_ITEM_REVIEW_REQUESTED
  /// Sub-phase 2.8a: a reviewer returned your work item, mailed at once when
  /// your preference says so (decision 161; the default).
  WORK_ITEM_REVIEW_RETURNED
}

/// A review round's state (sub-phase 2.8a, ADR 0009). PLANNED: steps editable,
/// nothing open; OPEN: a step is open; COMPLETED, RETURNED, WITHDRAWN: ended,
/// and from then on never rewritten (the trigger `work_item_review_round_frozen`).
enum ReviewRoundStatus {
  PLANNED
  OPEN
  COMPLETED
  RETURNED
  WITHDRAWN
}

/// Whether every reviewer of a step must sign off, or any one (ADR 0009 §1).
enum ReviewStepMode {
  ALL
  ANY
}

/// A review step's state (ADR 0009). PENDING: not yet open (editable); OPEN;
/// then COMPLETED, RETURNED, SKIPPED or WITHDRAWN, after which the step and
/// its responses are frozen (owner decision 162).
enum ReviewStepStatus {
  PENDING
  OPEN
  COMPLETED
  RETURNED
  SKIPPED
  WITHDRAWN
}

/// A reviewer's response (owner decision 148): Signed off or Returned.
enum ReviewOutcome {
  SIGNED_OFF
  RETURNED
}

/// A member's email choice for one notification type (sub-phase 2.7c, owner
/// decision 132). Not inflect-compliance's `NotificationDelivery`, whose
/// `DISABLED` would also govern the bell: the bell is `inApp`.
enum EmailDelivery {
  OFF
  IMMEDIATE
  DAILY
}

/// The state of a `NotificationOutbox` row.
enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// The fixed category every workflow state belongs to (ADR 0002 §3, ADR 0006
/// spelling). "Open" (BACKLOG, UNSTARTED, STARTED) and "closed" (DONE,
/// CANCELLED) are derived, never stored. Adding a category is a two-deploy
/// change: readers first, the writer second.
enum WorkflowStateCategory {
  BACKLOG
  UNSTARTED
  STARTED
  DONE
  CANCELLED
}

/// A work item's priority: a fixed scale (ADR 0006 "Priority").
enum WorkItemPriority {
  NONE
  URGENT
  HIGH
  MEDIUM
  LOW
}

/// The type of a `WorkItemRelation` (ADR 0002 §6).
enum WorkItemRelationType {
  BLOCKS
  RELATES
  DUPLICATES
}

/// The type of a project's custom field (ADR 0002 §7). Fixed at creation:
/// the value row's composite FK to `CustomField(id, type, …)` keeps it.
enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  PERSON
  URL
  CHECKBOX
}

/// How a saved view renders its rows (ADR 0006 "Layout"). TIMELINE is taken
/// since 3.1b and CALENDAR since 3.3a.
enum ViewLayout {
  LIST
  BOARD
  TIMELINE
  CALENDAR
}

/// Who sees a saved view: its creator only, or every member who sees its scope.
enum SavedViewVisibility {
  PERSONAL
  SHARED
}

/// Where a team's unfinished items go when one of its cycles ends (sub-phase
/// 2.5, owner decision 64): the next cycle, or no cycle.
enum CycleRollover {
  NEXT_CYCLE
  NO_CYCLE
}

/// How an intake request arrived (sub-phase 2.6; ADR 0006 "Intake channel").
/// PUBLIC_FORM and EMAIL are declared now and written from 2.6b and 2.6c, so
/// no later release adds a value a running container cannot read.
enum IntakeChannel {
  INTERNAL_FORM
  PUBLIC_FORM
  EMAIL
}

/// Who may send a request through an intake form (ADR 0006 "Intake form").
/// PUBLIC is refused by the usecases until 2.6b.
enum IntakeFormAccess {
  MEMBERS
  PUBLIC
}

/// Where an intake request stands (ADR 0006, decided 2026-11-20): shown as
/// New, Snoozed, Accepted, Declined and Merged.
enum IntakeRequestStatus {
  PENDING
  SNOOZED
  ACCEPTED
  DECLINED
  MERGED
}

/// Why a person declined an intake request (ADR 0006 "Decline reason").
enum IntakeDeclineReason {
  NOT_PLANNED
  OUT_OF_SCOPE
  SPAM
  OTHER
}

/// How often a repeat comes round (sub-phase 2.5d, owner decision 67).
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Why a repeat is on hold (sub-phase 2.5d, owner decision 70). Not
/// "Pause": ADR 0006 keeps that word away from the schema.
enum RecurrenceHold {
  /// The person who set it is no longer an active member.
  OWNER_NOT_ACTIVE
  /// They may no longer create work items in the item's project.
  OWNER_NOT_PERMITTED
  /// The item where the repeat was set was deleted.
  SOURCE_DELETED
  /// The item's project was archived.
  PROJECT_ARCHIVED
  /// The end date or the number of times was reached.
  ENDED
  /// A person put it on hold.
  HELD_BY_MEMBER
  /// The copy would break its type's field set (sub-phase 2.4b-b, owner
  /// decision 111): a required field it cannot fill, or a hidden one.
  FIELD_SET_UNMET
}

/// A field's rule in a work item type's field set (ADR 0002 §1, ADR 0006
/// "Field set"; sub-phase 2.4b-b). With no rule a field is OPTIONAL, except
/// the answer, which is HIDDEN.
enum FieldRequirement {
  REQUIRED
  OPTIONAL
  HIDDEN
}

/// An emailed request's sender authentication (sub-phase 2.6c, decision
/// 123), from the receiving MTA's `Authentication-Results`: absent, or not a
/// pass, is NONE.
enum IntakeSenderCheck {
  VERIFIED
  FAILED
  NONE
}

/// One inbound email delivery's state (sub-phase 2.6c).
enum IntakeInboundStatus {
  PENDING
  PROCESSED
  DROPPED
  FAILED
}

/// A person's judgement of a goal's or an initiative's outcome (sub-phase
/// 3.2; ADR 0002 §17, ADR 0006 "Health"; owner decisions 205 and 214). Never
/// derived from the status, progress or "late", and never setting them; NULL
/// on the row is "No health set".
enum Health {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
}

/// A goal's lifecycle (sub-phase 3.2; ADR 0006 "Goal status"; owner decision
/// 208): never "Active", which ADR 0006 reserves for agents.
enum GoalStatus {
  PLANNED
  STARTED
  COMPLETED
  CANCELLED
}

/// An initiative's lifecycle (sub-phase 3.2; ADR 0006 "Initiative status";
/// owner decision 208): the same four values as a goal's.
enum InitiativeStatus {
  PLANNED
  STARTED
  COMPLETED
  CANCELLED
}

/// A calendar provider a member connects (roadmap 3.3b; ADR 0011; decision 236).
enum CalendarProvider {
  GOOGLE
  MICROSOFT
}

/// A calendar connection's state (roadmap 3.3b; ADR 0011): REVOKED when the
/// provider refused the token (it is destroyed), DISCONNECTING while the
/// teardown deletes the remote events (decision 239), CALENDAR_REMOVED when
/// the member deleted the Islestone calendar (3.3c).
enum CalendarConnectionState {
  CONNECTED
  REVOKED
  DISCONNECTING
  CALENDAR_REMOVED
}

/// A synced event's state (roadmap 3.3b): PENDING_DELETE keeps the record of a
/// remote event whose delete failed; REMOVED_IN_CALENDAR is 3.3c's.
enum CalendarSyncedEventState {
  PUSHED
  PENDING_DELETE
  FAILED
  REMOVED_IN_CALENDAR
}

/// What a synced event stands for (decision 227: milestones too, read-only).
enum CalendarSyncedEventKind {
  WORK_ITEM
  MILESTONE
}
