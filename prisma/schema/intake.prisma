// Intake (sub-phase 2.6; docs/porting/maps/2.6.md; owner decisions 85 to 99;
// ADR 0006 "Intake", "Intake request", "Intake form", "Notify list"). An
// intake request is not a work item (ADR 0002 "Consequences"): accepting one
// creates the work item through the ordinary create path.
//
// What Prisma cannot declare (the status CHECKs, the caps) lives in migration
// `20261125120100_intake_core` (2.6a), `20261127120100_intake_public`
// (2.6b) and `20261201120100_intake_email` (2.6c), each with a catalogue test
// (tests/integration/intake-sql-constructs.test.ts).

/// A project's intake: whether it takes requests (sub-phase 2.6a), and its
/// email address (2.6c). Turned off, never deleted.
model ProjectIntake {
  id                  String    @id @default(cuid())
  tenantId            String
  projectId           String
  enabled             Boolean   @default(true)
  /// Whether the project's email address takes mail (2.6c; CHECK: only with
  /// a token).
  emailEnabled        Boolean   @default(false)
  /// The address's local part, `<token>@<INTAKE_EMAIL_DOMAIN>`: 12 characters
  /// of an unambiguous alphabet. Global, because an inbound email is resolved
  /// before any workspace is known. A new one retires the old for good.
  emailToken          String?   @unique
  emailTokenRotatedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// One per project; also the target the one-to-one relation needs.
  @@unique([projectId, tenantId])
  @@index([tenantId, projectId])
}

/// One member on a project's notify list (ADR 0006 "Notify list"): rung for
/// each new request. Leaves with the membership.
model IntakeNotifyMember {
  tenantId  String
  projectId String
  userId    String
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project          @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  member  TenantMembership @relation("IntakeNotifyMembership", fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, projectId])
}

/// A form that creates intake requests in one project (ADR 0006 "Intake
/// form"). Archived, never deleted (`app_user` holds no DELETE).
model IntakeForm {
  id                String           @id @default(cuid())
  tenantId          String
  projectId         String
  /// Plaintext, sanitised; unique among the project's forms.
  name              String
  access            IntakeFormAccess @default(MEMBERS)
  /// Random, about 128 bits, base64url: the only thing a public link (2.6b)
  /// carries. Global, because 2.6b resolves it before any workspace is known.
  publicId          String           @unique
  /// A form takes requests only while published and not archived.
  publishedAt       DateTime?
  archivedAt        DateTime?
  /// The intro, the form fields and the confirmation text, validated by
  /// `IntakeFormDefinitionSchema` (`src/lib/intake/form-definition.ts`). The
  /// workspace's own published text, not encrypted; sanitised on save.
  definitionJson    Json
  /// Increases on every save of the definition; a request records the
  /// version it answered.
  definitionVersion Int              @default(1)
  /// Optimistic concurrency for edits (`If-Match`).
  version           Int              @default(1)
  /// The most requests the form takes in a day (1 to 5,000, CHECK), counted
  /// in the database (decision 88; read from 2.6b).
  dailyCap          Int              @default(200)
  /// An actor stamp: a plain column, no FK.
  createdByUserId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  requests IntakeRequest[]

  @@unique([id, tenantId])
  @@unique([tenantId, projectId, name])
  @@index([tenantId, projectId, archivedAt])
}

/// One entry in intake (ADR 0006 "Intake request"). Purged 90 days after its
/// decision, spam after 7 (decision 90, `intake-purge`).
model IntakeRequest {
  id                    String               @id @default(cuid())
  tenantId              String
  projectId             String
  channel               IntakeChannel
  /// The form it answered. `NO ACTION`: forms are archived, never deleted,
  /// and a project's purge removes its forms and requests in one statement.
  formId                String?
  formDefinitionVersion Int?
  status                IntakeRequestStatus  @default(PENDING)
  /// Plaintext like a work item's title (decision 96), sanitised, at most 200.
  title                 String
  /// ENCRYPTED (manifest), sanitised plain text, at most 10,000.
  body                  String?
  /// ENCRYPTED (manifest): the answers as JSON text, `IntakeAnswers`.
  answersJson           String?
  /// The member who sent it (an internal form). An actor stamp: no FK, so
  /// the request outlives the membership.
  requesterUserId       String?
  /// A public form's requester (2.6b), when the form asks: personal data,
  /// encrypted in place by the PII extension (`PII_FIELD_MAP`).
  requesterName         String?
  /// A public form's requester's address (2.6b): personal data, encrypted in
  /// place; matched only through `requesterEmailHash` (`hashForLookup`).
  requesterEmail        String?
  requesterEmailHash    String?
  /// The requester ticked "Email me about this request" (2.6b).
  updatesRequested      Boolean              @default(false)
  /// The requester confirmed their address from the emailed link; notices
  /// are sent only after this (owner decision 89).
  updatesConfirmedAt    DateTime?
  /// sha256 of the confirmation link's token; cleared once used. Global:
  /// the link is resolved before any workspace is known.
  confirmTokenHash      String?              @unique
  /// The signed form token's nonce (2.6b): unique per workspace, so a token
  /// makes at most one request (decision 88).
  formTokenNonce        String?
  /// An emailed request's sender authentication, read from the receiving
  /// MTA's `Authentication-Results` (2.6c, decision 123; CHECK: set exactly
  /// on the EMAIL channel). Only VERIFIED is acknowledged or attributed to a
  /// member.
  senderCheck           IntakeSenderCheck?
  /// An emailed request's reply token: `<address token>+r<replyToken>@…`
  /// threads a reply onto it (2.6c). Global, resolved before any workspace.
  replyToken            String?              @unique
  /// sha256 of the email's Message-ID (2.6c): one request per message.
  sourceDedupeHash      String?
  /// Attachments an email carried, counted and never stored (until 4.4).
  attachmentsDropped    Int                  @default(0)
  /// Date-only; back to PENDING on this day at 08:00 in `NOTIFICATIONS_TZ`.
  snoozedUntil          DateTime?            @db.Date
  snoozedByUserId       String?
  decidedAt             DateTime?
  decidedByUserId       String?
  declineReason         IntakeDeclineReason?
  /// ENCRYPTED (manifest), sanitised: sent to an outside requester who
  /// confirmed their address (2.6b).
  declineExplanation    String?
  /// ENCRYPTED (manifest), sanitised: never sent.
  internalRemark        String?
  /// The work item an accepted request became. A plain column: the item may
  /// be purged while the request is kept; readers go through visibility.
  workItemId            String?
  mergedIntoWorkItemId  String?
  mergedIntoRequestId   String?
  version               Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)
  form      IntakeForm?      @relation(fields: [formId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction)
  followUps IntakeFollowUp[]

  @@unique([id, tenantId])
  @@unique([tenantId, formTokenNonce])
  @@unique([tenantId, sourceDedupeHash])
  /// The Intake list, per project and across the workspace.
  @@index([tenantId, projectId, status, createdAt])
  @@index([tenantId, status, createdAt])
  /// The wake job.
  @@index([tenantId, status, snoozedUntil])
  /// The purge job.
  @@index([tenantId, status, decidedAt])
  /// The per-form daily cap (2.6b) and the form's own list.
  @@index([tenantId, formId, createdAt])
  @@index([tenantId, requesterUserId, createdAt])
  /// A requester's other requests on a form (an address confirmed once).
  @@index([tenantId, requesterEmailHash, createdAt])
  /// The workspace's daily cap on public requests (2.6b).
  @@index([tenantId, channel, createdAt])
  @@index([tenantId, workItemId])
  @@index([tenantId, mergedIntoWorkItemId])
  @@index([tenantId, mergedIntoRequestId])
}

/// A later email on a new or snoozed emailed request (ADR 0006 "Follow-up";
/// sub-phase 2.6c). Goes with its request.
model IntakeFollowUp {
  id                 String   @id @default(cuid())
  tenantId           String
  requestId          String
  /// ENCRYPTED (manifest), sanitised plain text, at most 10,000.
  body               String
  /// sha256 of the email's Message-ID: one follow-up per message.
  sourceDedupeHash   String
  attachmentsDropped Int      @default(0)
  createdAt          DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request IntakeRequest @relation(fields: [requestId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, sourceDedupeHash])
  @@index([tenantId, requestId, createdAt])
}

/// An address a project, or the whole workspace, takes no intake from (ADR
/// 0006 "Blocked sender"; sub-phase 2.6c): its emails are dropped and its
/// public-form requests answered without being stored. Kept ONLY as the
/// address's lookup hash (`hashForLookup`), as ADR 0006 defines it: the
/// address itself is never stored. Removed by unblocking.
model IntakeBlockedSender {
  id              String   @id @default(cuid())
  tenantId        String
  /// The project it applies to; NULL is the whole workspace (one row per
  /// address, held by a partial unique index in the migration).
  projectId       String?
  emailHash       String
  /// An actor stamp: a plain column, no FK.
  createdByUserId String
  createdAt       DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, projectId, emailHash])
  /// The drop check, the project's and the workspace's rows at once.
  @@index([tenantId, emailHash])
  @@index([tenantId, projectId, createdAt])
}

/// One inbound email delivery (sub-phase 2.6c, decision 122): written by the
/// webhook when an address resolves, then claimed by the `intake-email-fetch`
/// job, which fetches the message and makes the request or follow-up. Holds
/// no address or text: the sender's lookup hash only. Purged after 30 days.
model IntakeInboundEmail {
  id          String              @id @default(cuid())
  tenantId    String
  projectId   String
  /// The webhook delivery's id (`svix-id`): global, a repeat is a no-op.
  svixId      String              @unique
  /// The received email's id at the provider (`email_id`): global.
  emailId     String              @unique
  status      IntakeInboundStatus @default(PENDING)
  /// Why a DROPPED or FAILED row stopped, a code (CHECK: with DROPPED).
  outcome     String?
  /// `hashForLookup` of the envelope sender, for the per-sender throttle.
  senderHash  String?
  /// The reply token the address carried, when it was a reply address.
  replyToken  String?
  attempts    Int                 @default(0)
  requestId   String?
  followUpId  String?
  createdAt   DateTime            @default(now())
  processedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  /// The per-address throttle.
  @@index([tenantId, projectId, createdAt])
  /// The per-sender throttle.
  @@index([tenantId, projectId, senderHash, createdAt])
  /// The purge.
  @@index([tenantId, createdAt])
}
