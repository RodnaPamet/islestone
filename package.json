    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-hook-form": "7.92.0",
    "react-resizable": "3.2.0",
    "react-window": "2.5.4",
    "sanitize-html": "2.18.2",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.1",
    "undici": "8.13.1",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/bcrypt": "6.0.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-array": "3.2.2",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "bcryptjs": "3.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "fast-check": "4.11.0",
    "husky": "9.1.7",
    "ioredis-mock": "8.13.1",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.2",
    "js-yaml": "5.5.0",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "web-vitals": "6.2.3"
  },
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-focus-scope": "1.3.1",
    "undici": "$undici",
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@prisma/config": {
      "effect": "3.22.4"
    }
  }
}
