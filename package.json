{
  "name": "islestone",
  "version": "0.0.0",
  "private": true,
  "description": "Islestone: AI-enabled project management.",
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/next-typegen.mjs && tsc --noEmit && npm run typecheck:ui",
    "test": "jest",
    "test:unit": "jest --selectProjects node",
    "test:rendered": "jest --selectProjects jsdom",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"tests/unit/**/*.test.mjs\"",
    "licence:check": "node scripts/licence-gate.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:scripts && npm run licence:check",
    "typecheck:ui": "tsc --noEmit -p packages/ui/tsconfig.json",
    "ui:verify": "node scripts/ui-drift.mjs verify"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "1.4.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.3.1",
    "@visx/axis": "4.0.0",
    "@visx/clip-path": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/gradient": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/text": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "d3-array": "3.2.5",
    "date-fns": "4.4.0",
    "lucide-react": "1.72.0",
    "motion": "13.5.1",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-array": "3.2.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
