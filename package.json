{
  "name": "islestone",
  "version": "0.0.0",
  "private": true,
  "description": "Islestone: AI-enabled project management.",
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "tsx scripts/worker.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/next-typegen.mjs && tsc --noEmit && npm run typecheck:ui",
    "test": "jest --selectProjects node jsdom",
    "test:unit": "jest --selectProjects node",
    "test:rendered": "jest --selectProjects jsdom",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"tests/unit/**/*.test.mjs\"",
    "licence:check": "node scripts/licence-gate.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:scripts && npm run licence:check",
    "typecheck:ui": "tsc --noEmit -p packages/ui/tsconfig.json",
    "ui:verify": "node scripts/ui-drift.mjs verify",
    "ui:mirror": "node scripts/ui-mirror.mjs verify",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:perf": "jest --selectProjects perf --runInBand",
    "seed:scale": "tsx scripts/seed-scale/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:check-schema-drift": "node scripts/check-fresh-db-schema-drift.mjs",
    "prepare": "husky",
    "secret-scan": "bash scripts/detect-secrets.sh --all"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@hookform/resolvers": "7.0.8",
    "@next-auth/prisma-adapter": "1.0.7",
    "@number-flow/react": "0.6.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
