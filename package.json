{
  "name": "islestone",
  "version": "0.0.0",
  "private": true,
  "description": "Islestone: AI-enabled project management.",
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/next-typegen.mjs && tsc --noEmit && npm run typecheck:ui",
    "test": "jest --selectProjects node jsdom",
    "test:unit": "jest --selectProjects node",
    "test:rendered": "jest --selectProjects jsdom",
    "test:e2e": "playwright test",
    "test:scripts": "node --test \"tests/unit/**/*.test.mjs\"",
    "licence:check": "node scripts/licence-gate.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:scripts && npm run licence:check",
    "typecheck:ui": "tsc --noEmit -p packages/ui/tsconfig.json",
    "ui:verify": "node scripts/ui-drift.mjs verify",
    "ui:mirror": "node scripts/ui-mirror.mjs verify",
    "test:integration": "jest --selectProjects integration --runInBand",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:check-schema-drift": "node scripts/check-fresh-db-schema-drift.mjs"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.3.1",
    "@visx/axis": "4.0.0",
    "@visx/clip-path": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/gradient": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/text": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-array": "3.2.5",
    "date-fns": "4.4.0",
    "lucide-react": "1.73.0",
    "motion": "13.5.1",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.3.0",
    "react-resizable": "3.2.0",
    "react-window": "2.5.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-array": "3.2.2",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.2",
    "js-yaml": "5.5.0",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.33",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@radix-ui/react-dismissable-layer": "1.2.1",
    "@radix-ui/react-focus-scope": "1.3.1"
  }
}
