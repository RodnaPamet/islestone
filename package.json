    "@visx/gradient": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@visx/text": "4.0.0",
    "@visx/tooltip": "4.0.0",
    "bcrypt": "6.0.0",
    "bullmq": "6.7.8",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3-array": "3.2.5",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
