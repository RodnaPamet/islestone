{
  "name": "islestone",
  "version": "0.0.0",
  "private": true,
  "description": "Islestone: AI-enabled project management.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node scripts/next-typegen.mjs && tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects node",
    "test:rendered": "jest --selectProjects jsdom",
    "test:e2e": "playwright test",
    "licence:check": "node scripts/licence-gate.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run licence:check"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.13.11",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
