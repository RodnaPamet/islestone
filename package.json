    "@sentry/nextjs": "11.16.0",
    "@svar-ui/react-gantt": "2.8.3",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.3.1",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "@visx/axis": "4.0.0",
    "@visx/clip-path": "4.0.0",
