# /opt/islestone/.env.prod — the template. NAMES ONLY: every value below is a
# placeholder. The real file lives on the VM, mode 600, owned by root, and is
# never committed, copied off the host or printed.
#
# deploy/apply.sh passes it to Compose with `--env-file`; Compose interpolates
# deploy/docker-compose.prod.yml from it, and each service receives only the
# variables its `environment:` names. A required value left empty aborts
# `docker compose up` with the message written beside it in the compose file.
#
# Generate:
#   openssl rand -hex 32        the three passwords (URL-safe: Compose builds
#                               the connection URLs from them)
#   openssl rand -base64 32     AUTH_SECRET
#   openssl rand -base64 48     DATA_ENCRYPTION_KEY, LOOKUP_HASH_KEY, DERIVED_SUBKEY_KEY
#
# tests/unit/deploy/compose-prod.test.ts holds this file equal to the
# variables the compose file reads.

# ── Required ──────────────────────────────────────────────────────────────
# The database superuser (migrations and backups only; never the app).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32 # pragma: allowlist secret
# The runtime role islestone_app (the app, the worker and PgBouncer).
APP_DB_PASSWORD=replace-with-openssl-rand-hex-32 # pragma: allowlist secret
REDIS_PASSWORD=replace-with-openssl-rand-hex-32 # pragma: allowlist secret
AUTH_SECRET=replace-with-openssl-rand-base64-32 # pragma: allowlist secret
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-48 # pragma: allowlist secret
# Set once, at first deploy, and never changed (docs/encryption.md).
LOOKUP_HASH_KEY=replace-with-openssl-rand-base64-48 # pragma: allowlist secret
DERIVED_SUBKEY_KEY=replace-with-openssl-rand-base64-48 # pragma: allowlist secret
# memory (owner decision 50, 2026-11-19): production runs a single app
# container, so per-process limits are exact limits. Revisit, and move to
# upstash with both UPSTASH values below, when the app scales past one
# container.
RATE_LIMIT_MODE=memory

# ── Read by deploy/backup.sh, not by Compose ──────────────────────────────
# The private, versioned bucket each backup is uploaded to, as the VM's
# service account (owner decision 48; docs/deployment.md, "Off-host copies").
# Empty: the upload is skipped with a warning.
BACKUP_GCS_BUCKET=islestone-backups-hazel-design-419410

# ── Optional (empty means unset) ──────────────────────────────────────────
# Pin app, worker and migrate to one published tag (sha-<short> or a version)
# instead of latest: the rollback lever (docs/deployment.md, "Rollback").
ISLESTONE_IMAGE_TAG=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public self-sign-up: 1 opens it; empty keeps it closed in production.
AUTH_PUBLIC_SIGNUP=
# Public intake forms (sub-phase 2.6b): 1 opens them; empty keeps them closed.
# Open them only once this release runs on both the app and the worker.
INTAKE_PUBLIC_FORMS=
# Inbound email (sub-phase 2.6c; docs/deployment.md, "Email (Resend)"): 1 opens
# it, empty keeps it closed; opened, both Resend values are required. Resend is
# a sub-processor (docs/sub-processors.md). Open it only once this release runs
# on both the app and the worker. INTAKE_EMAIL_AUTHSERV_ID is the authserv-id
# Resend's receiving server writes in Authentication-Results (read it off a real
# delivery); empty, no sender counts as authenticated.
INTAKE_EMAIL=
INTAKE_EMAIL_DOMAIN=in.islestone.cloud
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INTAKE_EMAIL_AUTHSERV_ID=
# Calendar sync (roadmap 3.3b, ADR 0011; docs/calendar-sync.md and
# docs/deployment.md, "Calendar sync"): 1 opens it, empty keeps it closed.
# Opened, at least one sign-in app pair below is required, with the calendar
# redirect URIs registered on it. Google and Microsoft are sub-processors for
# it (docs/sub-processors.md). Open it only once this release runs on both the
# app and the worker.
CALENDAR_SYNC=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Outbound mail through Resend (owner decision 120): SMTP_HOST=smtp.resend.com,
# SMTP_PORT=465 (or 587), SMTP_USER=resend, SMTP_PASS the Resend API key, and
# SMTP_FROM an address on the sending domain verified in Resend (eu-west-1).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SENTRY_DSN=
LOG_LEVEL=
CORS_ALLOWED_ORIGINS=
PLATFORM_ADMIN_API_KEY=
# Days a deleted goal or initiative stays restorable before the nightly purge
# (sub-phase 3.2a, owner decision 219); empty is 30.
GOAL_PURGE_DAYS=
# Days a deleted page group stays restorable before the nightly purge
# (sub-phase 4.1a, owner decision 344); empty is 30.
PAGE_PURGE_DAYS=
